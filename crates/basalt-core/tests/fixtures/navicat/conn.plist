					<key>host</key>
					<string>127.0.0.1</string>
					<key>port</key>
					<string>3306</string>
					<key>savepassword</key>
					<true/>
					<key>username</key>
					<string>root</string>
					<key>usehttptunnel</key>
					<false/>
					<key>usessl</key>
					<false/>
					<key>usetunnel</key>
					<false/>
				</dict>
				<key>测试 MySQL</key>
				<dict>
					<key>host</key>
					<string>mysql.example.test</string>
					<key>port</key>
					<string>13306</string>
					<key>savepassword</key>
					<true/>
