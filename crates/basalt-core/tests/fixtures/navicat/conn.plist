<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 合成夹具:结构仿照 Navicat 16 的 conn.plist({"0": {"0": {类型: {连接名: 字段}}}}),
     主机、用户名都是虚构的;真实文件里本来就没有密码字段。 -->
<plist version="1.0">
<dict>
	<key>0</key>
	<dict>
		<key>0</key>
		<dict>
			<key>MySQL</key>
			<dict>
				<key>本地 MySQL</key>
				<dict>
					<key>ServerVersion</key>
